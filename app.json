{
  "expo": {
    "name": "Dashword",
    "slug": "vocab-racer",
    "version": "1.0.01",
    "orientation": "portrait",
    "icon": "./assets/branding/dashword-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/branding/dashword-icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.revolutionti.dashword",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.revolutionti.dashword",
      "adaptiveIcon": {
        "backgroundColor": "#061C30",
        "foregroundImage": "./assets/branding/dashword-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/branding/dashword-favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": [
      "dashword",
      "vocab-racer"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fe820972-c3e9-4d01-8fe6-0c43eda87c0c"
      }
    }
  }
}
